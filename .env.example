PORT=4173
NODE_ENV=development
ADMIN_USERNAME=owner
ADMIN_PASSWORD=change-this-to-a-long-random-password
# در Production این دو Secret باید مستقل، تصادفی و حداقل ۳۲ نویسه باشند؛ مقدار نمونه باعث توقف امن سرویس می‌شود.
CSRF_SECRET=replace-with-at-least-32-random-bytes
AUTH_FINGERPRINT_SECRET=replace-with-another-random-secret
# تعداد proxyهای قابل اعتماد تا Railway؛ فقط عدد صحیح ۱ تا ۳.
TRUST_PROXY_HOPS=1
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_REALTIME_TRANSCRIBE_MODEL=gpt-live-transcribe
OPENAI_REALTIME_TRANSCRIBE_DELAY=low
RECEIPT_OCR_MODEL=gpt-5.4-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
VOICE_PROVIDER_ORDER=openai,gemini
DATABASE_PATH=./data/hesab-yar.sqlite
BACKUP_ENCRYPTION_KEY=replace-with-at-least-32-random-bytes
BACKUP_RETENTION_DAYS=14
# BACKUP_DIR=./data/backups
SEED_DEMO=false
